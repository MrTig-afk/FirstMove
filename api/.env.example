# FirstMove backend — copy to api/.env and fill in. NEVER commit the real .env.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require  # Neon connection string
API_KEY=dev-key                    # shared with the frontend (VITE_API_KEY)
DEV_MODE=true                      # true = localhost CORS; unset in production
ALLOWED_ORIGINS=https://your-app.vercel.app  # required in production (DEV_MODE unset)

# Ops alerts via ntfy.sh (optional — alerts are dropped silently if unset).
# Pick a long random topic name and subscribe to it in the ntfy app.
NTFY_TOPIC=your-random-topic-name
